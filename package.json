{
  "name": "wk5-lvl4-react-todo",
  "version": "1.0.0",
  "description": "This is the repo for my Wk 5, Level 4 Assignment, to build and deploy a React Todo SPA to s3+Serve via CloudFront.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:js": "eslint src --ext .js,.jsx",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "lint:html": "htmlhint index.html",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:html",
    "lint:js:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "lint:styles:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "lint:fix": "npm run lint:js:fix && npm run lint:styles:fix",
    "preview": "vite preview",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "sass": "^1.96.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "htmlhint": "^1.8.0",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.12.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.2.4"
  }
}
